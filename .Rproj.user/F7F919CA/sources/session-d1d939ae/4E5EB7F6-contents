/* ==========================================================================
   1. Colors & Body Styling
   ========================================================================== */
body {
    background-color: #fcfbf7; /* Off-white / light cream canvas background */
    color: #2b2b2b;            /* Soft dark charcoal for text (softer than pure black) */
    font-family: "Georgia", "Times New Roman", Times, serif; /* Clean, elegant serif */
    line-height: 1.6;
}

/* ==========================================================================
   2. Typography & Headings
   ========================================================================== */
h1, h2, h3, h4, .navbar-brand {
    font-family: "Georgia", "Times New Roman", Times, serif;
    font-weight: 600;
    color: #1a1a1a;
    margin-top: 1.5em;
}

h1 {
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
}

h2 {
    font-size: 1.5rem;
    border-bottom: none; /* Keeps it minimal without harsh divider lines */
    margin-top: 2rem;
}

/* ==========================================================================
   3. Navigation Bar Customization
   ========================================================================== */
.navbar {
    background-color: #fcfbf7 !important; /* Blends seamlessly with the background */
    border-bottom: 1px solid #e5e3de;     /* Very subtle separation line */
    font-family: "Georgia", "Times New Roman", Times, serif;
}

.navbar-light .navbar-nav .nav-link {
    color: #555555 !important;
}

.navbar-light .navbar-nav .nav-link:hover {
    color: #000000 !important; /* Darkens on hover */
}

.navbar-brand {
    font-weight: bold;
    color: #1a1a1a !important;
}

/* ==========================================================================
   4. Links & Social Icons
   ========================================================================== */
a {
    color: #4a6b53; /* A soft, muted dark sage green/earth tone for links */
    text-decoration: none;
    transition: color 0.2s ease-in-out;
}

a:hover {
    color: #2e4434; /* Darker green on hover */
    text-decoration: underline;
}

/* Style for the social/contact links directly under your name */
.about-links {
    margin-top: 1rem;
    margin-bottom: 2rem;
}

.about-link {
    margin-right: 15px;
    font-size: 0.95rem;
    color: #555555 !important;
    border: 1px solid #cccccc;
    padding: 5px 12px;
    border-radius: 20px; /* Gives them a neat pill-shaped button look */
    transition: all 0.2s ease;
}

.about-link:hover {
    background-color: #555555;
    color: #ffffff !important;
    text-decoration: none;
}

/* ==========================================================================
   5. About Me Page / Profile Layout
   ========================================================================== */
/* To make your profile image perfectly circular like Bella's */
.about-image, .quarto-about-solana img, .quarto-about-jolla img {
    border-radius: 50% !important; 
    border: 3px solid #ffffff;
    box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.05); /* Soft shadow */
    max-width: 200px;
    height: auto;
}